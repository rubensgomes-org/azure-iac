# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: 
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/

### MacOS files ###
.DS_Store

### AI plan files ###
misc/tasks/

### Terraform state pulled from the backend by `make pull-state` ###
# State holds every attribute of every resource, including values that are
# sensitive in outputs. Never commit it.
misc/state-backup/

### ---------- >>> Secrets <<< ---------- ###
# Core secrets files
.env
.env.local
.env.*.local

# API keys and certificates
*.pem
*.key
*.crt
*.cer
*.pub
*.pfx
*.p12
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
jwt.secret
certs/

# Cloud provider credentials
credentials.json
.aws/
.gcloud/

### ---------- >>> Release machinery <<< ---------- ###
# Transient scratch file from the `make release-<level>` changelog roll. Only
# ever present if awk or mv died mid-rewrite; it must never be committed.
CHANGELOG.md.tmp

# Scratch directory the Sonar scanner writes at the repo root (`make sonar`,
# and the scan step in release.yml). Not ignoring it bites indirectly:
# `make release-check` fails on a dirty working tree, so a local `make sonar`
# followed by `make release-patch` would abort the bump for a reason that looks
# nothing like the cause.
.scannerwork/
