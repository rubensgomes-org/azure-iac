# -----------------------------------------------------------------------------
# terraform/envs/dev/env.tfvars.example
# -----------------------------------------------------------------------------
# OPTIONAL template for a shared `env.tfvars`. Nothing requires this file: the
# Makefile passes `-var-file=../env.tfvars` only when it exists, and every
# value below can be supplied as a `TF_VAR_<name>` environment variable
# instead. That is how CI runs -- hosted runners receive no tfvars at all --
# and it is the recommended local setup too. See INITIAL_SETUP.md,
# "Terraform Environment".
#
# If you do want the file:
#
#   cp env.tfvars.example env.tfvars
#
# then fill in the two Entra values. `.gitignore` excludes `*.tfvars`, so the
# copy stays out of source control -- which is why this template exists and
# why the file is not simply committed.
#
# BEWARE the precedence: `-var-file` outranks `TF_VAR_*`. Once this file
# exists, every value in it silently wins over your shell, and nothing warns
# you. That is the one cost of keeping it.
#
# NOT here: tags. They live in the committed `tags.json`, read from disk by
# each root's `locals.tf`. A `tags` value set here would be merged over those
# defaults, which is a per-run override, not the place for the estate's tags.
# Use `TF_VAR_owner` to override the `owner` key alone.
#
# NOT here either: `rg_suffix`, nor the three state-backend coordinates
# (`backend_resource_group_name`, `storage_account_id`, `container_name`).
# All four come from `TF_VAR_*` for the precedence reason above -- a value in
# this file would silently make the environment variable a no-op, and for the
# backend coordinates that means aiming the remote-state reads at the wrong
# storage account. `rg_suffix` defaults to empty, which means no suffix.
# -----------------------------------------------------------------------------

# Environment token. Baked into nearly every resource name. ^[a-z][a-z0-9]{1,9}$
env = "dev"

# Azure region for the whole estate. `centralus` is not offer-restricted for
# PostgreSQL Flexible Server; see 09-postgresql/README.md before moving it.
location = "centralus"

# Owner/org token used in the Key Vault name (required by 05-key-vault).
# ^[a-z][a-z0-9]{1,15}$, and the total vault name must stay under 24 chars.
prefix = "rubens"

# Microservice names. One container app (11), one blob container (07) and one
# PostgreSQL database (09) is created per entry.
apps = ["api", "worker"]

# -----------------------------------------------------------------------------
# PostgreSQL Entra admin group (required by 09-postgresql)
# -----------------------------------------------------------------------------
# Both values describe the SAME group. The display name is passed explicitly
# rather than resolved from the object ID, because a `data.azuread_group`
# lookup needs Directory.Read scopes the Terraform SP typically lacks.
#
# Create the group and read its object ID with the commands in
# 09-postgresql/README.md, "One-time Entra admin group setup". The Terraform SP
# must be a MEMBER of this group.
# -----------------------------------------------------------------------------
pg_entra_admin_group_object_id = "00000000-0000-0000-0000-000000000000"
pg_entra_admin_group_name      = "az-dev-pg-admins"
