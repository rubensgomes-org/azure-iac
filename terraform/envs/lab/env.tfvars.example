# -----------------------------------------------------------------------------
# terraform/envs/lab/env.tfvars.example
# -----------------------------------------------------------------------------
# OPTIONAL template for a shared `env.tfvars`. Nothing requires this file: the
# Makefile passes `-var-file=../../envs/lab/env.tfvars` only when it exists, and
# every value below can be supplied as a `TF_VAR_<name>` environment variable
# instead. That is how CI runs -- hosted runners receive no tfvars at all --
# and it is the recommended local setup too. See INITIAL_SETUP.md,
# "Terraform Environment".
#
# If you do want the file:
#
#   cp env.tfvars.example env.tfvars
#
# then fill in the two Entra values. `.gitignore` excludes `*.tfvars`, so the
# copy stays out of source control -- which is why this template exists and
# why the file is not simply committed.
#
# BEWARE the precedence: `-var-file` outranks `TF_VAR_*`. Once this file
# exists, every value in it silently wins over your shell, and nothing warns
# you. That is the one cost of keeping it.
#
# NOT here: tags. They live in the committed `tags.json`, read from disk by
# each root's `locals.tf` at `../../envs/${var.env}/tags.json`. A `tags` value
# set here would be merged over those defaults, which is a per-run override,
# not the place for the estate's tags. Use `TF_VAR_owner` to override the
# `owner` key alone.
#
# NOT here either: the three state-backend coordinates
# (`backend_resource_group_name`, `storage_account_id`, `container_name`).
# All three come from `TF_VAR_*` for the precedence reason above -- a value in
# this file would silently make the environment variable a no-op, which for the
# backend coordinates means aiming the remote-state reads at another
# environment's storage.
#
# NOT here either: a per-root `terraform.tfvars`. The roots under
# terraform/roots/ are shared by every environment and Terraform auto-loads
# that filename, so one file would apply to dev and lab alike;
# `make check-tfvars` refuses one.
# -----------------------------------------------------------------------------

# Environment token. Baked into nearly every resource name. ^[a-z][a-z0-9]{1,9}$
# This is what makes a run "lab": the roots are shared and name no environment.
env = "lab"

# Azure region for the whole estate. `centralus` is not offer-restricted for
# PostgreSQL Flexible Server; see 09-postgresql/README.md before moving it.
location = "centralus"

# CAF workload token. Combined with `env` above it names EVERY resource in the
# estate: rg-rgomesapp-lab, kv-rgomes-lab, strgomesapplab, and so on.
# ^[a-z][a-z0-9]{1,15}$ — see docs/NAMING.md for the full name table.
#
# Two names are the binding constraints on its length, both capped at 24 chars
# with no random suffix left to absorb slack: the storage account
# (st<workload>app<env>, no dashes allowed) and the Key Vault
# (kv-<workload>-<env>). Both modules assert the composed length in a
# precondition, so an over-long value fails at plan time, not at apply.
#
# ForceNew everywhere. Change it at first provision or after a full teardown,
# never on a live estate.
workload = "rgomes"

# Microservice names. One container app (11), one blob container (07) and one
# PostgreSQL database (09) is created per entry.
apps = ["api", "worker"]

# -----------------------------------------------------------------------------
# PostgreSQL Entra admin group (required by 09-postgresql)
# -----------------------------------------------------------------------------
# Both values describe the SAME group. The display name is passed explicitly
# rather than resolved from the object ID, because a `data.azuread_group`
# lookup needs Directory.Read scopes the Terraform SP typically lacks.
#
# The group grants PG admin, not environment isolation, so one group per
# environment is a choice rather than a requirement. Commands are in
# 09-postgresql/README.md, "One-time Entra admin group setup". The Terraform SP
# must be a MEMBER of the group you name, and it cannot look the group up --
# `az ad group show` fails with "Insufficient privileges", which is why both
# the object ID and the display name are passed explicitly.
# -----------------------------------------------------------------------------
pg_entra_admin_group_object_id = "00000000-0000-0000-0000-000000000000"
pg_entra_admin_group_name      = "az-lab-pg-admins"

# -----------------------------------------------------------------------------
# Values that MUST differ from dev, and are NOT in this file
# -----------------------------------------------------------------------------
# `TF_VAR_env` is the one that MUST change, and it is what makes a run lab:
#
#   export TF_VAR_env='lab'
#
# `TF_VAR_container_name` does not change. Lab inherited `tfstate-lab-rgomes`,
# the container the destroyed dev estate had used, so the value already
# exported for dev is correct here -- see backend.hcl. It is a future `dev`
# that needs a new one (`tfstate-dev-rgomes`).
#
# `TF_VAR_acr_name` must differ from any other LIVE environment's: registry
# names are globally unique across Azure. Lab uses `crrgomesdev01`, freed when
# the dev estate was destroyed. A second concurrent environment needs its own --
# verify with `az acr check-name -n <name>` before setting it.
#
# `make check-backend` fails the run if TF_VAR_env or TF_VAR_container_name
# disagrees with the ENV you selected, which is the trap worth guarding: the
# environment variable outranks backend.hcl at init time, so a value left over
# from another environment's session would quietly point this plan at that
# environment's state.
# -----------------------------------------------------------------------------
